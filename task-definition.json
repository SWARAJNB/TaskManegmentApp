{
  "family": "taskflow-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::152537192875:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "152537192875.dkr.ecr.YOUR_AWS_REGION.amazonaws.com/taskflow-backend:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000
        }
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql://postgres:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/postgres"
        },
        {
          "name": "SECRET_KEY",
          "value": "YOUR_SUPER_SECURE_JWT_SECRET_KEY"
        }
      ]
    },
    {
      "name": "frontend",
      "image": "152537192875.dkr.ecr.YOUR_AWS_REGION.amazonaws.com/taskflow-frontend:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80
        }
      ],
      "environment": [
        {
          "name": "VITE_API_URL",
          "value": "http://localhost:8000"
        }
      ]
    }
  ]
}
